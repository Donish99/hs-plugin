{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@hs/*": ["src/hubspot/*"],
      "@campaigns/*": ["src/campaigns/*"],
      "@ai/*": ["src/ai/*"],
      "@outreach/*": ["src/outreach/*"],
      "@test/*": ["src/test/*"]
    }
  }
}
