# HubSpot App Credentials
HUBSPOT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_APP_ID=123456
HUBSPOT_DEVELOPER_API_KEY=xxx

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hubspot_dormant_leads

# Redis
REDIS_URL=redis://localhost:6379

# AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxxxx

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE=+1234567890

# Security
ENCRYPTION_KEY=32-byte-key-for-token-encryption
JWT_SECRET=your-jwt-secret

# App
APP_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:3000/api/webhooks/hubspot
NODE_ENV=development
PORT=3000

# GitHub (for MCP)
GITHUB_TOKEN=ghp_xxxxx
