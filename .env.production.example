# ============================================
# HubSpot Dormant Lead Reactivation - Production
# ============================================
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# Then run:
#   docker compose --env-file .env.production up -d --build

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=hubspot_plugin

# ---- HubSpot ----
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
HUBSPOT_DEVELOPER_API_KEY=

# ---- OpenAI ----
OPENAI_API_KEY=

# ---- SendGrid (Email) ----
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Dormant Lead Reactivator

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ---- Security ----
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
JWT_SECRET=

# ---- Application ----
# Set to your domain with HTTPS
APP_URL=https://level-test.uz:4501
CORS_ORIGINS=https://level-test.uz:4501

# ---- Company Info (for email footers / CAN-SPAM) ----
COMPANY_NAME=Your Company
COMPANY_ADDRESS=123 Main St, City, State 12345
