{
  "name": "hubspot-dormant-leads-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:backend": "pnpm --filter @hsdl/backend run start:dev",
    "dev:frontend": "pnpm --filter @hsdl/frontend run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf node_modules dist"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0"
}
